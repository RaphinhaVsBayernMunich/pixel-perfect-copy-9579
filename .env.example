# Server runtime only; enter values in your independent hosting secret manager.
DEEPSEEK_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
INSTALL_FINGERPRINT_PEPPER=
BILLING_ENVIRONMENT=live
APP_ORIGIN=
# Direct Stripe server keys. Never public or VITE-prefixed.
STRIPE_LIVE_SECRET_KEY=
STRIPE_SANDBOX_SECRET_KEY=
PAYMENTS_LIVE_WEBHOOK_SECRET=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_APP_ID=
REVENUECAT_WEBHOOK_AUTH=

# Public build configuration. These values are embedded in browser code.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PAYMENTS_CLIENT_TOKEN=
VITE_REVENUECAT_ANDROID_KEY=
# Enable only after configuring/testing Supabase Google OAuth with native PKCE.
VITE_NATIVE_GOOGLE_AUTH_ENABLED=false
VITE_GOOGLE_AUTH_ENABLED=false

# Native build origin; HTTPS production origin, no path, localhost, credentials or query.
CAPACITOR_SERVER_URL=
QUESTOS_VERSION_CODE=1
QUESTOS_VERSION_NAME=1.0.0
# Signing values belong in local shell/CI secrets, never source control.
QUESTOS_KEYSTORE_PATH=
QUESTOS_KEYSTORE_PASSWORD=
QUESTOS_KEY_ALIAS=
QUESTOS_KEY_PASSWORD=
